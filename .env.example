# Copy to .env: `cp .env.example .env`. Values below work with docker-compose as is.

APP_URL=http://localhost:3000
LOG_LEVEL=info

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=media_review
DATABASE_URL=postgres://app:app@postgres:5432/media_review

REDIS_URL=redis://redis:6379

S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="Media Review Hub <no-reply@media-review.local>"
